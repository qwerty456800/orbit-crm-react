# --- Local database (used when DATABASE_URL is not set) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orbit_crm
DB_USER=postgres
DB_PASSWORD=
PORT=3000

# --- Cloud database (Neon, Render, ...) ---
# One connection string instead of the DB_* values above. TLS is used by default.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Frontends allowed to call the API, comma-separated. Unset = any origin (local dev).
# CORS_ORIGIN=https://your-app.vercel.app

# Demo sandboxes unused for this many hours are deleted with their data.
# DEMO_SESSION_TTL_HOURS=24

# --- Frontend (read by Vite at build time) ---
# URL of the deployed API. Unset = http://localhost:3000
# VITE_API_URL=https://your-api.onrender.com
